// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Keyword {
  id        String    @id @default(uuid())
  text      String    @unique
  category  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  hotspots  Hotspot[]
}

model Hotspot {
  id              String    @id @default(uuid())
  title           String
  content         String
  url             String
  source          String    // twitter, hackernews, bilibili, juejin, weibo
  sourceId        String?   // 原始推文ID等
  isReal          Boolean   @default(true)
  relevance       Int       @default(0)
  relevanceReason String?   // AI 分析相关性的理由
  keywordMentioned Boolean?  // 内容中是否直接提及了关键词
  importance      String    @default("low")
  summary         String?
  viewCount       Int?
  likeCount       Int?
  retweetCount    Int?
  replyCount      Int?      // 回复数
  commentCount    Int?      // 评论数
  quoteCount      Int?      // 引用/转引数
  danmakuCount    Int?      // 弹幕数 (Bilibili)
  authorName      String?   // 作者名称
  authorUsername  String?   // 作者用户名
  authorAvatar    String?   // 作者头像
  authorFollowers Int?      // 作者粉丝数
  authorVerified  Boolean?  // 作者是否认证
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  keywordId       String?
  keyword         Keyword?  @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  @@unique([url, source])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // hotspot, alert
  title     String
  content   String
  isRead    Boolean  @default(false)
  hotspotId String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// 发件 SMTP 账户
model EmailAccount {
  id        String   @id @default(uuid())
  name      String            // 备注名，如 "QQ邮箱-工作"
  host      String            // SMTP 服务器地址
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String            // SMTP 用户名（登录账号）
  password  String            // 密码/授权码
  isActive  Boolean  @default(false)  // 当前使用，全局仅一个（路由层保证）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 收件邮箱
model EmailRecipient {
  id        String   @id @default(uuid())
  name      String?           // 备注名（可选）
  address   String   @unique  // 收件邮箱
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 公众号订阅
model WechatAccount {
  id            String          @id @default(uuid())
  name          String          // 公众号名称
  bizId         String?         // 公众号 __biz 标识（可选）
  avatar        String?         // 头像地址
  description   String?         // 简介
  sourceType    String          @default("rss") // rss | sogou | api，预留多来源
  feedUrl       String          @unique        // 文章源地址
  isActive      Boolean         @default(true)
  baselineDone  Boolean         @default(false) // 是否已建立首批基线
  lastCheckedAt DateTime?
  lastArticleAt DateTime?       // 已见最新文章时间
  failCount     Int             @default(0)
  lastError     String?
  nextCheckAt   DateTime?       // 失败退避后的下次检查时间
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  articles      WechatArticle[]
}

// 公众号文章
model WechatArticle {
  id          String        @id @default(uuid())
  account     WechatAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  title       String
  url         String        @unique
  digest      String?
  coverUrl    String?
  author      String?
  publishedAt DateTime?
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([accountId, publishedAt])
}
