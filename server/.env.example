# 数据库
DATABASE_URL="file:./dev.db"

# 服务器配置
PORT=3001
CLIENT_URL=http://localhost:5173

# 模型服务（可选，也可以在网页设置里配置，界面配置优先）
# DeepSeek
DEEPSEEK_API_KEY=
# 小米 MiMo
MIMO_API_KEY=
# OpenCode Go
OPENCODE_API_KEY=

# Twitter API (twitterapi.io)
TWITTER_API_KEY=your_twitter_api_key_here

# 微博关键词搜索（可选，不配置时自动走访客 Cookie + 热搜兜底）
WEIBO_COOKIE=

# 搜索结果缓存时长（毫秒，默认 20 分钟）
SEARCH_CACHE_TTL_MS=1200000
